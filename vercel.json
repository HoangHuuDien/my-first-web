{
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "data/{SYSTEM_PROMPT.md,brandvoice.md,sales_script.md}"
    },
    "api/process-email-sequence.js": {
      "maxDuration": 60,
      "includeFiles": "data/email_sequence.md"
    },
    "api/orders/send-confirmation.js": {
      "maxDuration": 60,
      "includeFiles": "data/order_confirmation_email.md"
    }
  },
  "crons": [],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/payment", "destination": "/payment/index.html" },
    { "source": "/payment/", "destination": "/payment/index.html" },
    { "source": "/thank-you", "destination": "/thank-you/index.html" },
    { "source": "/thank-you/", "destination": "/thank-you/index.html" }
  ]
}
