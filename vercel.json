{
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "includeFiles": "data/{SYSTEM_PROMPT.md,brandvoice.md,sales_script.md}"
    },
    "api/process-email-sequence.js": {
      "maxDuration": 60,
      "includeFiles": "data/email_sequence.md"
    },
    "api/admin/run-email-sequence.js": {
      "maxDuration": 60,
      "includeFiles": "data/email_sequence.md"
    }
  },
  "crons": [
    {
      "path": "/api/process-email-sequence",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/payment", "destination": "/payment/index.html" },
    { "source": "/payment/", "destination": "/payment/index.html" },
    { "source": "/thank-you", "destination": "/thank-you/index.html" },
    { "source": "/thank-you/", "destination": "/thank-you/index.html" }
  ]
}
