# === Server ===
NODE_ENV=production
PORT=3000

# === API chat (OpenRouter) ===
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# === Supabase ===
# URL + anon/publishable: client (qua /js/client-env.js)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# Service role: CHỈ server — admin API + cron email
SUPABASE_SERVICE_ROLE_KEY=

# === Email (Resend) ===
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Thuận Thiên <hello@yourdomain.com>

# === Bảo mật cron / webhook ===
CRON_SECRET=generate-a-long-random-string
ORDER_CONFIRM_SECRET=

# === Site & thanh toán (client + email) ===
SITE_URL=https://your-subdomain.example.com
GIFT_DOWNLOAD_URL=https://drive.google.com/...
PAYMENT_ACCOUNT=0977611153
PAYMENT_BANK=MB
PAYMENT_AMOUNT=500000

# === Make.com (chat widget gửi lead) ===
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxxx

# === Telegram (form đơn mới — server /api/notify-telegram) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Supabase Edge Function sepay-webhook (cấu hình trên Supabase Dashboard, không file này) ===
# SEPAY_WEBHOOK_API_KEY=
